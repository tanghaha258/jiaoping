# Application
APP_NAME=智跨学评 API
APP_ENV=development
DEBUG=true

# Database
# Local trial uses SQLite. Docker trial can use PostgreSQL:
# postgresql+asyncpg://app:change_me_in_production@postgres:5432/zhikua_xueping
DATABASE_URL=sqlite+aiosqlite:///./app.db

# JWT
# Change before any real school trial.
JWT_SECRET=change-this-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Guangxi JiaoTong AI agent integration placeholders.
# Leave empty to use the local MockProvider while preserving the same contract.
GJT_API_BASE_URL=
GJT_API_KEY=
GJT_AGENT_ID=
GJT_API_TIMEOUT_SECONDS=30

# Domestic OpenAI-compatible model gateways.
# Keep real keys in backend environment variables, not in frontend-visible JSON.
OPENAI_COMPATIBLE_API_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60

# CORS
# For production, replace * with the deployed frontend origin.
CORS_ORIGINS=["*"]
